# MySQL connection settings (template)
# 1. Copy this file and rename the copy to ".env"
# 2. Replace the placeholder password with your own MySQL password
# The real ".env" file is listed in .gitignore, so it is never pushed to GitHub.

DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=localhost
DB_PORT=3306
DB_NAME=earthquake_db
